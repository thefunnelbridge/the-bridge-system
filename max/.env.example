# Copia este archivo como .env para probar Max en tu computador.
# El archivo .env nunca se sube a GitHub.
# En Netlify estas mismas variables van en:
#   Site configuration > Environment variables

# Usuario y clave para entrar a Max. Si MAX_USER queda vacío, el usuario es: javier
MAX_USER=
MAX_PASSWORD=

# PIN de la zona privada "Mi mes" (distinto de la clave). Se usa desde la parte 3.
MAX_PIN_PRIVADO=

# Texto secreto largo (mínimo 32 caracteres) para firmar la sesión.
# Para generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Se usa desde la parte 5 (resumen hablado y la barra).
ANTHROPIC_API_KEY=

# Opcional. Sin esta clave, Max usa la voz gratis del navegador.
ELEVENLABS_API_KEY=
